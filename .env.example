# How to run AgentMesh
#
# DEMO MODE (default, free, offline, no keys):
#   Just: docker compose up --build
#
# LIVE TRANSLATIONS (free MyMemory API, no key, needs internet):
#   USE_REAL_TRANSLATOR=true
#   Any API hiccup falls back to the built-in dictionary for that item,
#   so the mesh never stalls. The dashboard pill shows which mode is live.
#
# Copy this file to .env to make overrides permanent.
# .env is git-ignored, so nothing secret ever leaves your machine.

TARGET_LANG=fr
MAX_RETRIES=2
TRAIL_DIR=./trail
GATEWAY_PORT=8080
USE_REAL_TRANSLATOR=false
